# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lead_capture

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5500", "http://127.0.0.1:5500"]

# Geo APIs
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co/json

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_WIDGET=20

# Email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@leadcapture.com

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
DEBUG=True
